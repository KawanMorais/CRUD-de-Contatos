@model UsuarioModel

@{
    ViewData["Title"] = "Confirmação de apagar o usuário";
}



<div class="text-center">
    <h3 class="mb-3">Realmente deseja apagar o usuário (@Model.Nome)? </h3>
</div>

<a class="btn btn-primary w-100 mb-2" role="button" asp-controller="Usuario" asp-action="index">Cancelar exclusão</a>
<a class="btn btn-danger w-100" role="button" asp-controller="Usuario" asp-route-id="@Model.Id" asp-action="Apagar">Confirmar exclusão</a>